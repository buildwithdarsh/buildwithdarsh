# ── Lead emails via Resend (app/actions.ts) ─────────────────────────
# Copy to .env.local and fill in. NEVER put a real key in this file — it is the
# one env file .gitignore force-includes, so it gets committed.
#
# Without RESEND_API_KEY both forms still validate, but submissions fail
# honestly: the visitor is told to email directly, and diagnostic requests are
# written to the server log so none are lost.

# Resend API key — https://resend.com/api-keys
# Same Resend account as work.withdarsh.com is fine.
RESEND_API_KEY=

# Sender. Its domain MUST be verified at https://resend.com/domains or every send
# fails 403. "onboarding@resend.dev" needs no domain but only delivers to the
# Resend account owner — fine for testing, not for real visitors.
# e.g. LEAD_FROM_EMAIL="Darsh at withdarsh <darsh@withdarsh.com>"
LEAD_FROM_EMAIL=

# Where new diagnostic requests and checklist downloads land.
# Defaults to site.email in lib/content.ts.
LEAD_NOTIFY_EMAIL=

# ── Optional: Resend segments for follow-up Automations ─────────────
# Run `npm run resend:setup` once to create these and print the IDs.
# Leads are always saved as Resend contacts and fire the events
# `checklist.requested` / `diagnostic.requested`; build drips on those in the
# Resend dashboard → Automations, no code changes needed.
RESEND_SEGMENT_CHECKLIST=
RESEND_SEGMENT_DIAGNOSTIC=
